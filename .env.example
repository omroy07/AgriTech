# ==============================================================================
# AgriTech Environment Configuration Template
# Copy this file to `.env` in the root directory and update with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
FLASK_ENV=development               # development | staging | production | testing
DEBUG=True                          # Set to False in production
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8501

# ------------------------------------------------------------------------------
# 2. Database & Connection Pooling
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///agritech_dev.db
DEV_DATABASE_URL=sqlite:///agritech_dev.db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440     # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. Feature Flags (Gradual Rollouts & Toggle Control)
# ------------------------------------------------------------------------------
ENABLE_AI_DISEASE=True
ENABLE_PREDICTION_COMPARISON=True
ENABLE_SEEDLING_CLASSIFICATION=True
ENABLE_WEATHER_ADVISORY=True
ENABLE_SPATIAL_ANALYTICS=True
ENABLE_CROP_RECOMMENDATION=True
ENABLE_CARBON_PORTAL=True
ENABLE_VOICE_INPUT=True
ENABLE_OFFLINE_CACHE=True
ENABLE_RATE_LIMITER=True

# ------------------------------------------------------------------------------
# 5. Artificial Intelligence & ML Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
DISEASE_CONFIDENCE_THRESHOLD=75.0
MAX_IMAGE_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. External APIs & Microservices
# ------------------------------------------------------------------------------
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1
FX_API_URL=https://api.exchangerate-api.com/v4/latest

# ------------------------------------------------------------------------------
# 7. Caching, Redis & Celery Message Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=SimpleCache               # SimpleCache (dev) or RedisCache (prod)
CACHE_DEFAULT_TIMEOUT=3600
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 8. Storage Configuration (Local vs Cloud S3)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local                  # local | s3
MAX_CONTENT_LENGTH=10485760         # 10MB in bytes
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 9. Firebase Configuration (Web & Mobile Auth/DB)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 10. Email & Notification Server (SMTP)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@agritech.com
